# Maintainer: unoctanium

pkgname=inpmap
pkgver=0.3.0
pkgrel=1
pkgdesc="Configuration-driven input remapper: one key can drive several virtual devices"
arch=('any')
url="https://github.com/unoctanium/InpMap"
license=('MIT')
depends=('python' 'python-evdev' 'python-lark-parser')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('evtest: show the events of input devices')
install=inpmap.install
source=("https://files.pythonhosted.org/packages/source/i/$pkgname/$pkgname-$pkgver.tar.gz"
        "inpmap@.service"
        "70-inpmap-uinput.rules")
sha256sums=('468de4ad711fb9f1f8afe1b2dbf6df0562f20f65220a324946d9257a359f0d75'
            '145e4c37729992ff6817f205590b6705066ba524361a67768ffb3565357d48ce'
            '06669ec9a93c7870e2ae8f76c54ef1dbff6b6e7a85c1d1627090e563c235a2a9')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # Unit tests only; the hardware tests (-m hardware) need /dev/uinput.
  PYTHONPATH="$PWD/src" python -m pytest -q -p no:cacheprovider
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/inpmap@.service" "$pkgdir/usr/lib/systemd/user/inpmap@.service"
  install -Dm644 "$srcdir/70-inpmap-uinput.rules" "$pkgdir/usr/lib/udev/rules.d/70-inpmap-uinput.rules"
  install -Dm644 src/inpmap/data/syntax/inpmap.xml \
    "$pkgdir/usr/share/org.kde.syntax-highlighting/syntax/inpmap.xml"
  install -Dm644 src/inpmap/data/syntax/inpmap.nanorc "$pkgdir/usr/share/nano/inpmap.nanorc"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/*.md -t "$pkgdir/usr/share/doc/$pkgname/docs"
}
